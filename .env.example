# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Auth Secret for Admin sessions (generate with `openssl rand -base64 32`)
JWT_SECRET="your-secure-jwt-secret-key-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Credentials (used during prisma/seed.ts)
ADMIN_DEFAULT_EMAIL="admin@novaestate.ae"
ADMIN_DEFAULT_PASSWORD="YourAdminSecurePassword123!"
